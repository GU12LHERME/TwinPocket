if(NOT EXISTS "${TE_ANDROID_SMOKE_BINARY}")
    message(FATAL_ERROR "Android smoke binary was not produced: ${TE_ANDROID_SMOKE_BINARY}")
endif()

file(READ "${TE_ANDROID_SMOKE_BINARY}" _te_elf_hex OFFSET 0 LIMIT 20 HEX)
string(TOLOWER "${_te_elf_hex}" _te_elf_hex)
string(SUBSTRING "${_te_elf_hex}" 0 12 _te_elf_header)
string(SUBSTRING "${_te_elf_hex}" 36 4 _te_elf_machine)
if(NOT _te_elf_header STREQUAL "7f454c46020101")
    message(FATAL_ERROR "Expected a little-endian 64-bit ELF artifact; header=${_te_elf_header}")
endif()
if(NOT _te_elf_machine STREQUAL "b700")
    message(FATAL_ERROR "Expected ELF machine AArch64 (183); e_machine=${_te_elf_machine}")
endif()
message(STATUS "Android smoke artifact verified: ELF64 little-endian, AArch64")
