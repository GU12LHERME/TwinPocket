function(te_validate_android_elf_fields out_valid out_reason ident_hex version_hex machine_hex)
    string(TOLOWER "${ident_hex}" ident_hex)
    string(TOLOWER "${version_hex}" version_hex)
    string(TOLOWER "${machine_hex}" machine_hex)

    if(NOT ident_hex STREQUAL "7f454c460201")
        set(${out_valid} FALSE PARENT_SCOPE)
        set(${out_reason} "expected ELF magic, ELFCLASS64, and ELFDATA2LSB; ident=${ident_hex}" PARENT_SCOPE)
        return()
    endif()
    if(NOT version_hex STREQUAL "01")
        set(${out_valid} FALSE PARENT_SCOPE)
        set(${out_reason} "expected ELF identification version 1; version=${version_hex}" PARENT_SCOPE)
        return()
    endif()
    if(NOT machine_hex STREQUAL "b700")
        set(${out_valid} FALSE PARENT_SCOPE)
        set(${out_reason} "expected ELF machine AArch64 (183); e_machine=${machine_hex}" PARENT_SCOPE)
        return()
    endif()

    set(${out_valid} TRUE PARENT_SCOPE)
    set(${out_reason} "ELF64 little-endian, AArch64" PARENT_SCOPE)
endfunction()

if(TE_ANDROID_ELF_VERIFIER_TEST)
    te_validate_android_elf_fields(_valid _reason "7f454c460201" "01" "b700")
    if(NOT _valid)
        message(FATAL_ERROR "Valid ELF64 little-endian AArch64 fields were rejected: ${_reason}")
    endif()

    foreach(_invalid_case IN ITEMS magic class endian version architecture)
        set(_ident "7f454c460201")
        set(_version "01")
        set(_machine "b700")
        if(_invalid_case STREQUAL "magic")
            set(_ident "000000000201")
        elseif(_invalid_case STREQUAL "class")
            set(_ident "7f454c460101")
        elseif(_invalid_case STREQUAL "endian")
            set(_ident "7f454c460202")
        elseif(_invalid_case STREQUAL "version")
            set(_version "00")
        elseif(_invalid_case STREQUAL "architecture")
            set(_machine "3e00")
        endif()
        te_validate_android_elf_fields(_valid _reason "${_ident}" "${_version}" "${_machine}")
        if(_valid)
            message(FATAL_ERROR "Invalid ELF field case '${_invalid_case}' was accepted")
        endif()
    endforeach()
    message(STATUS "Android ELF verifier tests passed (valid accepted; invalid rejected)")
    return()
endif()

if(NOT EXISTS "${TE_ANDROID_SMOKE_BINARY}")
    message(FATAL_ERROR "Android smoke binary was not produced: ${TE_ANDROID_SMOKE_BINARY}")
endif()

# Read ELF identification and e_machine independently. A bounded read of 20
# bytes can be returned as only the six-byte identification prefix by some
# CMake versions; e_machine is at byte offset 18 and is checked separately.
file(READ "${TE_ANDROID_SMOKE_BINARY}" _te_elf_ident OFFSET 0 LIMIT 6 HEX)
file(READ "${TE_ANDROID_SMOKE_BINARY}" _te_elf_version OFFSET 6 LIMIT 1 HEX)
file(READ "${TE_ANDROID_SMOKE_BINARY}" _te_elf_machine OFFSET 18 LIMIT 2 HEX)
te_validate_android_elf_fields(_te_elf_valid _te_elf_reason
    "${_te_elf_ident}" "${_te_elf_version}" "${_te_elf_machine}")
if(NOT _te_elf_valid)
    message(FATAL_ERROR "Invalid Android ELF artifact: ${_te_elf_reason}")
endif()
message(STATUS "Android smoke artifact verified: ${_te_elf_reason}")
