<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00030002" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!-- the launcher's short taps on confirm / tab change (Haptics.java): a normal permission, granted at install -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:hasCode="true"
        android:icon="@mipmap/ic_crash_launcher"
        android:isGame="true"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_crash_launcher_round"
        android:supportsRtl="true">

        <!-- The entry: Java only, the app's main process. The launcher: the game, the settings (ps2r.ini), the diagnostics.
             Every activity is fixed in the device's standard landscape ("landscape", not "sensorLandscape"): no rotation
             with the device's movement, whatever Android's auto-rotate setting says (MainActivity also keeps SDL from
             asking for another orientation). -->
        <activity
            android:name="com.twinsanityevolved.game.LauncherActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SDL2's activity with libSDL2.so + libmain.so, in its own process: a crash ends this process only. -->
        <activity
            android:name="com.twinsanityevolved.game.MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":game"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- The diagnostic mode: loads the native libraries and runs the probe without the game, in its own process. -->
        <activity
            android:name="com.twinsanityevolved.game.ProbeActivity"
            android:exported="false"
            android:process=":probe"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <provider
            android:name="com.twinsanityevolved.game.LogProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
